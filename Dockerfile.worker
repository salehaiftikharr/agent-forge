# The durable worker (and the migrate one-shot) run from this image. It carries
# the engine and the practice-repo seed. tsx is kept (not --omit=dev) because the
# worker runs TypeScript directly, matching the local workflow.
FROM node:22-slim
WORKDIR /app

# better-sqlite3 ships prebuilt binaries for node 22 (linux x64/arm64); npm ci
# uses them, so no compiler toolchain is needed in the image.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ENV FORGE_DB_PATH=/data/forge.db \
    FORGE_RUNS_DIR=/data/runs \
    FORGE_SEED_DIR=/app/sandbox \
    LLM_PROVIDER=fake

# Default command runs the worker; the compose migrate service overrides it.
CMD ["npm", "run", "worker"]
