# Agent Forge web tier — environment.
#
# The web tier holds NO model credentials and no other secrets. It is a client of
# the shared SQLite database that the worker writes; point it at the same file.
#
# The marketing/demo pages still need nothing at runtime. The functional app
# (/work and /api/*) needs the database path below.

# Path to the shared SQLite database (must match the worker's FORGE_DB_PATH).
# Default: ./.forge-data/forge.db relative to the web working directory.
# FORGE_DB_PATH=/data/forge.db

# Reported on /api/health and used to label the UI. Set to the SAME value as the
# worker. "fake" = deterministic offline provider; "anthropic"/"openai" = live.
# LLM_PROVIDER=fake

# Optional: canonical https origin, used only for absolute links.
# NEXT_PUBLIC_SITE_URL=

# Never put a real model key here or anywhere in the web tier or client bundle.
